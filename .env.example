# Chaves públicas do Supabase usadas pelo navegador.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Site key pública do Cloudflare Turnstile, entregue ao navegador por endpoint do servidor.
TURNSTILE_SITE_KEY=turnstile-site-key

# Origem canônica usada em callbacks OAuth e recuperação de senha.
SEKAI_SITE_URL=https://sekai.example

# Integrações somente servidor (configure apenas onde cada recurso for habilitado).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PUSHER_APP_ID=
PUSHER_SECRET=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
METERED_API_KEY=
METERED_APP_NAME=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
ELEVENLABS_API_KEY=

# Chaves públicas de integrações existentes (o navegador as recebe em configuração pública).
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example
NEXT_PUBLIC_PUSHER_KEY=pusher-public-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=spotify-client-id
